@using OllamaOpenApi.Dto
@using OllamaOpenApi.ServiceClient.Services
@inject IOllamaApiService ApiService

<div class="modal fade show" style="display: block; background-color: rgba(0,0,0,0.5);" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Select Working Folder</h5>
                <button type="button" class="btn-close" @onclick="Cancel"></button>
            </div>
            <div class="modal-body" style="max-height: 60vh; overflow-y: auto;">
                <div class="mb-3">
                    <button class="btn btn-sm btn-outline-secondary me-2" @onclick="GoUp" disabled="@(string.IsNullOrEmpty(currentPath) || currentPath == rootPath)">
                        <i class="bi bi-arrow-up"></i> Up
                    </button>
                    <span class="text-truncate" style="display: inline-block; max-width: 80%;">
                        Current Path: <strong>@currentPath</strong>
                    </span>
                </div>
                <div class="list-group">
                    @foreach (var item in items)
                    {
                        <button type="button" 
                                class="list-group-item list-group-item-action d-flex align-items-center @(item.IsDirectory ? "" : "text-muted")" 
                                @onclick="() => OnItemClick(item)">
                            <i class="bi @(item.IsDirectory ? "bi-folder-fill text-warning" : "bi-file-earmark-text") me-2"></i>
                            <span class="text-truncate">@item.Name</span>
                        </button>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="SelectCurrent">Select This Folder</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback<string> OnSelected { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string? InitialPath { get; set; }

    private string currentPath = "";
    private string rootPath = "";
    private List<FolderDto> items = new();

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(InitialPath))
        {
            currentPath = InitialPath;
        }

        await LoadFolders();
    }

    private async Task LoadFolders()
    {
        items = await ApiService.GetFoldersAsync(currentPath);
        
        if (string.IsNullOrEmpty(rootPath) && items.Any())
        {
            // This is a simplification. In a real app, you might want a fixed root.
            // We'll just use a common root based on the first path we see.
            var firstPath = items.First().Path;
            rootPath = Path.GetPathRoot(firstPath) ?? "/";
        }
    }

    private async Task OnItemClick(FolderDto item)
    {
        if (item.IsDirectory)
        {
            currentPath = item.Path;
            await LoadFolders();
        }
        else
        {
            await OnSelected.InvokeAsync(item.Path);
        }
    }

    private async Task GoUp()
    {
        if (string.IsNullOrEmpty(currentPath)) return;
        
        var directory = new DirectoryInfo(currentPath);
        if (directory.Parent != null)
        {
            currentPath = directory.Parent.FullName;
            await LoadFolders();
        }
    }

    private async Task SelectCurrent()
    {
        await OnSelected.InvokeAsync(currentPath);
    }

    private async Task Cancel()
    {
        await OnCancel.InvokeAsync();
    }
}
